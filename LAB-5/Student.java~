public class Student
{
  public String name = "";
  public int code = 0;
  public int trace = 0;
  public static int total_students = 0;
  public static double averageMarks = 0;
  public Student(String name)
  {
    this.name = name;
    this.total_students++;
  }
  public Student(String name, int code, int trace)
  {
    this.name = name;
    this.code = code;
    this.trace = trace;
    this.total_students++;
  }
  public void setCodingMarks()
  {
    this.code = code;
  }
  public void setTracingMarks()
  {
    this.trace = trace;
  }
  public double averageMarks()
  {
    this.averageMarks = (this.code+this.trace)/total_students;
    return this.averageMarks;
  }
  public void individualDetail()
  {
    System.out.println("Name: "+this.name);
    System.out.println("ID: ");
    System.out.println("Coding Marks: "+this.code);
    System.out.println("Tracing Marks: "+trace);
    if((this.code+this.trace)<50)
    {
      System.out.println("Mike has failed with "+(this.code+this.trace)+" marks");
    }
    else
    {
      System.out.println("Will has passed with "+(this.code+this.trace)+" marks");
    }
  }
}