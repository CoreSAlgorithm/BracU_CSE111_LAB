public class Team
{
  public String teamname = "";
  public String[] player = new String[11];
  public String[] age = new String[11];
  public String[] totalmatch = new String[11];
  public int count = 0;
  public void updateName(String teamname)
  {
    this.teamname = teamname;
  }
  public void addPlayer(Player p)
  {
    if(count < 11)
    {
      this.player[count] = p.name;
      this.age[count] = p.age;
      this.totalmatch[count] = p.totalmatch;
      count++;
    }
    else
    {
      System.out.println("No spot available.");
    }
  }
  public void printDetail()
  {
    System.out.println("Team: "+this.teamname);
    System.out.println("List of players:");
    for(int i=0; i<count; i++)
    {
      System.out.println("Name: "+this.player[i]);
      System.out.println("Age: "+this.age[i]+", "+"Total Matches: "+this.totalmatch);
    }
  } 
}